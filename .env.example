# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
APP_ENV=development
APP_BASE_URL=
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
COOKIE_SECURE=0
AUTO_INIT_DB=1

# MySQL / AWS RDS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=codealpha_security

# AES-256-GCM key: exactly 32 random bytes, URL-safe base64 encoded.
# Generate with:
# python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AES_256_KEY=replace-with-generated-32-byte-key

# Login protection
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=300
